  "completion_rule": "A job cannot become DONE until the system checks for a reusable Part and a process improvement; record only material harvest.",
  "critters": {
    "echo": {
      "name": "Echo",
      "role": "Chief of Staff / Router",
      "inputs": "Goals, evidence, exceptions, approvals",
      "outputs": "Priorities, routed work, decisions",
      "permissions": "Route and approve within human-set authority",
      "limits": "Cannot invent the mission or silently override Shannon",
      "stop": "Escalate material conflicts or irreversible choices",
      "waste": "Squirrel remembers decisions"
    },
    "owl": {
      "name": "Owl",
      "role": "Research Scout",
      "inputs": "Endgame goals, unknowns, research requests",
      "outputs": "Evidence packets, options, sources, unanswered questions",
      "permissions": "Research and compare",
      "limits": "No builds, no spending, no priority changes",
      "stop": "Stop when evidence is sufficient for a decision",
      "waste": "Beetle/Squirrel preserve useful research"
    },
    "beaver": {
      "name": "Beaver",
      "role": "Builder",
      "inputs": "Echo-approved work orders",
      "outputs": "Code, prototypes, tests, docs, reusable modules",
      "permissions": "Modify designated working builds",
      "limits": "No self-assigned mission or production deploy without approval",
      "stop": "Return BLOCKED rather than expanding scope",
      "waste": "Beetle decomposes; Parts Bin harvests"
    },
    "beetle": {
      "name": "Beetle",
      "role": "Decomposer / Maintainer",
      "inputs": "Failures, stale code, duplicates, abandoned work",
      "outputs": "Cleanup proposals, salvage, technical-debt reports",
      "permissions": "Inspect all; non-destructive maintenance",
      "limits": "No silent destructive deletion",
      "stop": "Request approval before irreversible cleanup",
      "waste": "Goat later handles true retirement"
    },
    "hawk": {
      "name": "Hawk",
      "role": "Systems Monitor",
      "inputs": "Telemetry, queues, failures, costs, retries",
      "outputs": "Health reports, bottlenecks, anomaly alerts",
      "permissions": "Observe and flag",
      "limits": "Does not fix or redirect work itself",
      "stop": "Escalate severe health/security conditions",
      "waste": "Jane interprets behavior; Echo routes fixes"
    },
    "jane": {
      "name": "Jane",
      "role": "Field Ecologist",
      "inputs": "Behavioral record of critter interactions",
      "outputs": "Handoff observations, niche conflicts, emergent-pattern reports",
      "permissions": "Observe and recommend",
      "limits": "Does not command critters",
      "stop": "Escalate only through Echo/Shannon",
      "waste": "Squirrel stores institutional learning"
    },
    "squirrel": {
      "name": "Squirrel",
      "role": "Interrupt / Continuity / Archive",
      "inputs": "Prominent interruptions, snapshots, decisions",
      "outputs": "Pause snapshot, redirect/resume state, archive memory",
      "permissions": "Pause claiming of new work and preserve state",
      "limits": "Does not decide strategic priority alone",
      "stop": "Wait for Echo/Shannon resume or redirect",
      "waste": "Pantry retains history"
    },
    "dog": {
      "name": "Dog",
      "role": "Guardian",
      "inputs": "Permissions, secret/security events, suspicious behavior",
      "outputs": "Blocks, alerts, boundary reports",
      "permissions": "Stop unsafe operations",
      "limits": "Cannot initiate projects",
      "stop": "Escalate uncertain or high-impact security decisions",
      "waste": "Hawk/Jane record incidents"
    },
    "bees": {
      "name": "Bees",
      "role": "Connectors",
      "inputs": "Useful outputs and reusable artifacts",
      "outputs": "Cross-project links and reuse suggestions",
      "permissions": "Index and connect",
      "limits": "No mutation of source artifacts",
      "stop": "Do not create duplicate copies without a need",
      "waste": "Squirrel/Parts Bin preserve canonical asset"
    }
  },
